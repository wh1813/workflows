def load_latest_cookie_str():
    if os.path.exists(LOCAL_COOKIE_FILE):
        try:
            with open(LOCAL_COOKIE_FILE, "r", encoding="utf-8") as f:
                c = f.read().strip()
                if c and "=" in c:
                    return c
        except Exception:
            pass
