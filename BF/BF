def _extract_all_html_from_resp(resp):
    raw_text = resp.text
    html_pieces = []

    def walk_json(obj):
        if isinstance(obj, str):
            if "<tr" in obj or "col-title" in obj or "<a " in obj or "下一页" in obj:
                html_pieces.append(obj)
        elif isinstance(obj, dict):
            for v in obj.values():
                walk_json(v)
        elif isinstance(obj, list):
            for item in obj:
                walk_json(item)

    try:
        data = resp.json()
        walk_json(data)
        if html_pieces:
            return "\n".join(html_pieces)
    except Exception:
        pass

    if r'\"' in raw_text or r"\/" in raw_text:
        try:
            unescaped = raw_text.encode("utf-8").decode("unicode_escape")
            if "col-title" in unescaped or "data-aid" in unescaped:
                return unescaped
        except Exception:
            pass
        return raw_text.replace(r'\"', '"').replace(r"\/", "/")

    return raw_text


def _parse_book118_page(html_content):
    from bs4 import BeautifulSoup
    soup = BeautifulSoup(html_content, "html.parser")
    doc_list = []

    rows = soup.find_all("tr", attrs={"data-aid": True})
    if not rows:
        for a_tag in soup.select("td.col-title a.title"):
            tr_parent = a_tag.find_parent("tr")
            if tr_parent and tr_parent not in rows:
                rows.append(tr_parent)

    for row in rows:
        doc_id = row.get("data-aid", "").strip()
        if not doc_id:
            checkbox = row.select_one("input[type='checkbox']")
            doc_id = checkbox.get("value", "").strip() if checkbox else ""

        title_tag = row.select_one("td.col-title a.title")
        if title_tag:
            title = title_tag.get("title") or title_tag.get_text(strip=True)
            href = title_tag.get("href", "")
            full_url = urllib.parse.urljoin(BOOK118_BASE_URL, href)
        else:
            title = row.get("data-title", "").strip()
            full_url = ""

        row_classes = row.get("class", [])
        is_recommend = "已推荐" if "is-recommend" in row_classes else "未推荐"

        click_tag = row.select_one("td.col-click")
        clicks = click_tag.get_text(strip=True) if click_tag else "0"

        coins = row.select("td.col-coin")
        ori_coin = coins[0].get_text(strip=True) if len(coins) > 0 else ""
        cur_price = coins[1].get_text(strip=True) if len(coins) > 1 else ""

        size_tag = row.select_one("td.col-size")
        page_tag = row.select_one("td.col-pagenumber")
        time_tag = row.select_one("td.col-time")

        molds = row.select("td.col-mold")
        category = molds[0].get_text(strip=True) if len(molds) > 0 else ""
        audit_status = molds[1].get_text(strip=True) if len(molds) > 1 else ""

        doc_list.append({
            "文档ID": doc_id,
            "文档标题": title,
            "文档链接": full_url,
            "推荐状态": is_recommend,
            "点击量": clicks,
            "金币": ori_coin,
            "现价": cur_price,
            "大小": size_tag.get_text(strip=True) if size_tag else "",
            "页数": page_tag.get_text(strip=True) if page_tag else "",
            "上传时间": time_tag.get_text(strip=True) if time_tag else "",
            "分类": category,
            "状态": audit_status
        })

    next_url = None
    next_tag = soup.find("a", string=lambda text: text and "下一页" in text)
    if next_tag:
        next_href = next_tag.get("href", "").strip()
        if next_href and not next_href.startswith("javascript"):
            next_url = urllib.parse.urljoin(BOOK118_BASE_URL, next_href)

    return doc_list, next_url


def _append_docs_to_csv(docs, csv_file=CSV_OUTPUT_FILE):
    if not docs:
        return
    fieldnames = [
        "文档ID", "文档标题", "文档链接", "推荐状态", "点击量",
        "金币", "现价", "大小", "页数", "上传时间", "分类", "状态"
    ]
    file_exists = os.path.isfile(csv_file)
    with open(csv_file, mode="a", encoding="utf-8-sig", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        if not file_exists:
            writer.writeheader()
        writer.writerows(docs)
        f.flush()
        os.fsync(f.fileno())


def run_book118_crawler_and_update_urls(use_proxy=False, urls_file=LOCAL_URLS_FILE):
    bjt_str = get_beijing_now().strftime("%Y-%m-%d %H:%M:%S")
    cookie_str = load_latest_cookie_str()
    target_max_pages = random.randint(CRAWL_MIN_PAGES, CRAWL_MAX_PAGES)

    logger.info("\n" + "★" * 60)
    logger.info(f"⏰ [爬虫任务启动] 北京时间: {bjt_str}")
    logger.info(f"📂 目标写入绝对路径: {os.path.abspath(urls_file)}")
    logger.info(f"🍪 Cookie 来源: {'/home/container/cookie.txt' if os.path.exists(LOCAL_COOKIE_FILE) else '代码内置 DEFAULT_COOKIE_STR'}")
    logger.info(f"🕷️ 本次随机设定抓取前 {target_max_pages} 页 (范围:{CRAWL_MIN_PAGES}~{CRAWL_MAX_PAGES}页)，筛选点击量 < {CRAWL_MAX_CLICKS} 的链接...")
    logger.info("★" * 60)

    if os.path.exists(CSV_OUTPUT_FILE):
        try:
            os.remove(CSV_OUTPUT_FILE)
        except Exception:
            pass

    session = requests.Session()
    session.headers.update({
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
        "Referer": "https://max.book118.com/user_center_v1/doc/index/index.html",
        "X-Requested-With": "XMLHttpRequest",
        "Accept": "application/json, text/javascript, text/html, */*; q=0.01",
        "Accept-Language": "zh-CN,zh;q=0.9",
    })
    requests.utils.add_dict_to_cookiejar(session.cookies, _parse_cookie_str(cookie_str))

    proxies = {
        "http": f"http://127.0.0.1:{LOCAL_HTTP_PORT}",
        "https": f"http://127.0.0.1:{LOCAL_HTTP_PORT}"
    } if use_proxy else None

    current_url = BOOK118_START_URL
    total_count = 0
    low_click_urls = []
    page_num = 1

    channel_order = [None, proxies] if use_proxy else [None]

    while current_url and page_num <= target_max_pages:
        logger.info(f"   📄 [爬虫进度 {page_num}/{target_max_pages}] 正在抓取后台第 {page_num} 页...")
        resp = None
        last_err = None
        for ch_proxy in channel_order:
            try:
                r = session.get(current_url, proxies=ch_proxy, timeout=18, verify=False)
                if r.status_code == 200 and len(r.text.strip()) > 30:
                    resp = r
                    break
            except Exception as e:
                last_err = e
                continue

        if resp is None:
            logger.error(f"   ❌ 抓取第 {page_num} 页网络请求失败 ({last_err})，停止翻页。")
            break

        try:
            resp.encoding = "utf-8"
            html_content = _extract_all_html_from_resp(resp)
            docs, next_url = _parse_book118_page(html_content)

            if not docs:
                snippet = re.sub(r"\s+", " ", resp.text[:350])
                logger.warning(f"   ⚠️ 第 {page_num} 页未提取到文档 | 响应内容: {snippet}")
