            _append_docs_to_csv(docs, CSV_OUTPUT_FILE)
            total_count += len(docs)

            page_qualified = 0
            for d in docs:
                raw_click = str(d.get("点击量", "0")).strip()
                digits = re.findall(r"\d+", raw_click)
                click_val = int(digits[0]) if digits else 0
                doc_url = d.get("文档链接", "").strip()

                if click_val < CRAWL_MAX_CLICKS and doc_url:
                    if not doc_url.startswith(("http://", "https://")):
                        doc_url = "https://" + doc_url
